    {
      "name": "4. CRUD ms-estacionamiento",
      "item": [
        {
          "name": "S1 Crear estacionamiento temporal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{estacionamientoUrl}}/api/estacionamientos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoTemp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"codigoTemp\", \"X\" + (Date.now() % 100000000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"estacionamientoTempId\", json.id);"
                ]
              }
            }
          ]
        },
        {
